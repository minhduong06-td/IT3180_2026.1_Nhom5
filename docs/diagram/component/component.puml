@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor black
skinparam classBackgroundColor #FFFFCC
skinparam classBorderColor black
skinparam classAttributeIconSize 0
skinparam usecaseBackgroundColor #FFFFCC
skinparam usecaseBorderColor black
skinparam actorBorderColor black
skinparam actorBackgroundColor #FFFFCC
skinparam activityBackgroundColor #FFFFCC
skinparam activityBorderColor black
skinparam partitionBackgroundColor #FFFFCC
skinparam partitionBorderColor black
skinparam sequenceParticipantBackgroundColor #FFFFCC
skinparam sequenceParticipantBorderColor black
skinparam sequenceLifeLineBorderColor black
skinparam sequenceArrowColor black
skinparam componentBackgroundColor #FFFFCC
skinparam componentBorderColor black
skinparam databaseBackgroundColor #FFFFCC
skinparam databaseBorderColor black
skinparam nodeBackgroundColor #FFFFCC
skinparam nodeBorderColor black
skinparam artifactBackgroundColor #FFFFCC
skinparam artifactBorderColor black
!pragma layout smetana
left to right direction
title BlueMoon — component diagram
package "Desktop application" {
  component "JavaFX views\nLoginView, MainShell,\nBillingView, ChargesView, ..." as UI
  component "Authentication & accounts\nAuthService, AccountService" as Auth
  component "Building management\nApartmentService, ResidentService,\nVehicleService, UtilityService" as Building
  component "Billing & collections\nFeeService, BillingService,\nCollectionService, BillingRules" as Billing
  component "Requests & reporting\nResidentRequestService,\nDashboardService, ContributionService" as Other
  component "Domain records & enums\nDomain" as Model
  component "JDBC repository\nAppRepository" as Repo
  component "Database connection\nDatabase" as Config
  component "Schema bootstrap\nDatabaseBootstrap" as Bootstrap
}
component "BCrypt" as Crypto
database "MySQL\nbluemoon" as DB
UI --> Auth
UI --> Building
UI --> Billing
UI --> Other
UI ..> Model
Auth --> Repo
Building --> Repo
Billing --> Repo
Other --> Repo
Auth --> Crypto : password hashes
Auth ..> Model
Billing ..> Model
Repo ..> Model
Repo --> Config
Bootstrap --> Config
Config --> DB : JDBC / Connector-J
@enduml
