@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor black
skinparam classBackgroundColor #FFFFCC
skinparam classBorderColor black
skinparam classAttributeIconSize 0
skinparam usecaseBackgroundColor #FFFFCC
skinparam usecaseBorderColor black
skinparam actorBorderColor black
skinparam actorBackgroundColor #FFFFCC
skinparam activityBackgroundColor #FFFFCC
skinparam activityBorderColor black
skinparam partitionBackgroundColor #FFFFCC
skinparam partitionBorderColor black
skinparam sequenceParticipantBackgroundColor #FFFFCC
skinparam sequenceParticipantBorderColor black
skinparam sequenceLifeLineBorderColor black
skinparam sequenceArrowColor black
skinparam componentBackgroundColor #FFFFCC
skinparam componentBorderColor black
skinparam databaseBackgroundColor #FFFFCC
skinparam databaseBorderColor black
skinparam nodeBackgroundColor #FFFFCC
skinparam nodeBorderColor black
skinparam artifactBackgroundColor #FFFFCC
skinparam artifactBorderColor black
!pragma layout smetana
left to right direction
title BlueMoon — use cases
actor "Ban quản trị" as A
actor "Kế toán" as K
actor "Cư dân" as R
rectangle BlueMoon {
  usecase "Đăng nhập / đổi mật khẩu" as Login
  usecase "Quản lý tài khoản" as Accounts
  usecase "Quản lý căn hộ và nhân khẩu" as Housing
  usecase "Ghi nhận biến động cư trú" as Residence
  usecase "Quản lý phương tiện" as Vehicles
  usecase "Nhập hóa đơn tiện ích" as Utilities
  usecase "Quản lý khoản thu và đơn giá" as Fees
  usecase "Phát hành kỳ thu" as Issue
  usecase "Chọn đơn giá đầu kỳ" as Rate
  usecase "Cấn số dư kỳ trước" as Credit
  usecase "Ghi nhận thanh toán" as Pay
  usecase "Ghi nhận tiền nộp dư" as Overpay
  usecase "Xem bảng kê, công nợ và lịch sử" as Debt
  usecase "In thông báo / xuất CSV" as Export
  usecase "Ghi nhận đóng góp tự nguyện" as Contrib
  usecase "Tạo yêu cầu cư dân" as Request
  usecase "Xử lý yêu cầu cư dân" as Handle
}
A -- Login
K -- Login
R -- Login
A -- Accounts
A -- Housing
A -- Residence
A -- Vehicles
A -- Utilities
A -- Fees
A -- Issue
Issue ..> Rate : <<include>>
Issue ..> Credit : <<include>>
K -- Pay
Overpay ..> Pay : <<extend>>
A -- Debt
K -- Debt
R -- Debt
A -- Export
K -- Export
A -- Contrib
K -- Contrib
R -- Request
A -- Request
A -- Handle
@enduml
