@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor black
skinparam classBackgroundColor #FFFFCC
skinparam classBorderColor black
skinparam classAttributeIconSize 0
skinparam usecaseBackgroundColor #FFFFCC
skinparam usecaseBorderColor black
skinparam actorBorderColor black
skinparam actorBackgroundColor #FFFFCC
skinparam activityBackgroundColor #FFFFCC
skinparam activityBorderColor black
skinparam partitionBackgroundColor #FFFFCC
skinparam partitionBorderColor black
skinparam sequenceParticipantBackgroundColor #FFFFCC
skinparam sequenceParticipantBorderColor black
skinparam sequenceLifeLineBorderColor black
skinparam sequenceArrowColor black
skinparam componentBackgroundColor #FFFFCC
skinparam componentBorderColor black
skinparam databaseBackgroundColor #FFFFCC
skinparam databaseBorderColor black
skinparam nodeBackgroundColor #FFFFCC
skinparam nodeBorderColor black
skinparam artifactBackgroundColor #FFFFCC
skinparam artifactBorderColor black
title Ghi nhận thanh toán
actor "Kế toán" as Accountant
participant ChargesView as View
participant CollectionService as Service
participant AppRepository as Repo
participant BillingRules as Rules
database MySQL as DB
Accountant -> View : chọn charge và nhập thông tin
View -> Service : recordPayment(user, chargeId, amount, ...)
Service -> Service : kiểm tra ACCOUNTANT, ngày, người nộp, mã
alt không hợp lệ
  Service --> View : lỗi quyền / dữ liệu
else hợp lệ
  Service -> Repo : recordPayment(chargeId, amount, ...)
  Repo -> DB : GET_LOCK(reference); BEGIN
  Repo -> DB : kiểm tra mã đã ghi nhận
  alt mã trùng
    Repo -> DB : ROLLBACK; RELEASE_LOCK
    Repo --> Service : lỗi
  else mã mới
    Repo -> DB : khóa charge, đọc số đã cấn
    Repo -> Rules : validatePayment(amount, balance)
    Repo -> Repo : applied = min(amount, balance)\ncredit = amount - applied
    Repo -> DB : INSERT payment
    opt credit > 0
      Repo -> DB : INSERT apartment_credit
    end
    alt lỗi
      Repo -> DB : ROLLBACK
      Repo -> DB : RELEASE_LOCK
      Repo --> Service : lỗi
    else thành công
      Repo -> DB : COMMIT
      Repo -> DB : RELEASE_LOCK
      Repo --> Service : PaymentReceipt(received, applied, credit)
      Service --> View : PaymentReceipt
      View --> Accountant : hiển thị phiếu và số dư
    end
  end
end
@enduml
